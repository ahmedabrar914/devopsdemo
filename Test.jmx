pipeline {
    agent any

    stages {
        stage('Clone Repo') {
            steps {
                checkout scm
            }
        }

        stage('Upload .jmx with Current Date') {
            steps {
                script {
                    def vm = '10.216.55.34'
                    def pwd = 'hdfc@123'
                    def dateStr = new Date().format("ddMMMyyyy")  // e.g., 12Jun2025
                    def remoteJmxFile = "MBR_Test_${dateStr}.jmx"
                    def remoteJmxPath = "/home1/QK/MBR/scripts/MBR_R1_Perf1_Sanity_Usecase_Flows_30-Nov-2023/${remoteJmxFile}"

                    // Save full path for later use
                    env.REMOTE_JMX_PATH = remoteJmxPath
                    env.REMOTE_JMX_FILE = remoteJmxFile

                    sh """
                        sshpass -p '${pwd}' scp -o StrictHostKeyChecking=no testplan.jmx hdfcbank@${vm}:${remoteJmxPath}
                    """
                }
            }
        }

        stage('Run JMeter with Dynamic JMX') {
            steps {
                script {
                    def vm = '10.216.55.34'
                    def pwd = 'hdfc@123'
                    def jtlPath = "/home1/QK/MBR/Results/R28_${env.REMOTE_JMX_FILE.replace('.jmx','.jtl')}"
                    def htmlPath = "/home1/QK/MBR/HTMLReports/Report_${env.REMOTE_JMX_FILE.replace('.jmx','.html')}"

                    // Save HTML path for pull step
                    env.REMOTE_HTML_PATH = htmlPath

                    sh """
                        sshpass -p '${pwd}' ssh -o StrictHostKeyChecking=no hdfcbank@${vm} '
                            /home1/apache-jmeter-5.4.2_bkKP/bin/jmeter.sh -n \
                            -t ${env.REMOTE_JMX_PATH} \
                            -l ${jtlPath} \
                            -e -o ${htmlPath}
                        '
                    """
                }
            }
        }

        stage('Copy HTML Report') {
            steps {
                sh """
                    mkdir -p reports
                    sshpass -p 'hdfc@123' scp -o StrictHostKeyChecking=no -r \
                    hdfcbank@10.216.55.34:${env.REMOTE_HTML_PATH} ./reports/
                """
            }
        }

        stage('Publish Report') {
            steps {
                publishHTML(target: [
                    reportDir: 'reports',
                    reportFiles: "${env.REMOTE_HTML_PATH.tokenize('/')[-1]}",
                    reportName: 'Dynamic JMeter Report'
                ])
            }
        }
    }
}
