pipeline {
  agent any

  environment {
    // JMeter VM
    JM_VM        = '10.216.33.52'
    JM_USER      = 'hdfcbank'
    JM_PASS      = 'PerfTest@1'
    JM_BIN       = '/home1/jmeter/bin/jmeter.sh'
    JM_SCRIPTS   = '/home1/QK/MBR/scripts'
    JM_RESULTS   = '/home1/QK/MBR/Results'
    JM_HTML      = '/home1/QK/MBR/HTML_Reports'

    // Pod-check VM
    POD_VM       = '10.216.33.44'
    POD_USER     = 'hdfcbank'
    POD_PASS     = 'perf@123'
    POD_NAME     = 'user-profile-v1'
    POD_NS       = 'perf-mc'
  }

  stages {
    stage('Wait for Pod to be Running') {
      steps {
        script {
          timeout(time: 10, unit: 'MINUTES') {
            waitUntil {
              def status = sh(
                script: """
                  sshpass -p '${POD_PASS}' ssh -o StrictHostKeyChecking=no ${POD_USER}@${POD_VM} \\
                    kubectl get pod ${POD_NAME} -n ${POD_NS} -o jsonpath='{.status.phase}'
                """,
                returnStdout: true
              ).trim()
              echo "→ ${POD_NAME} status: ${status}"
              return (status == 'Running')
            }
          }
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Run JMeter on Remote VM') {
      steps {
        script {
          def jmxName   = 'testplan.jmx'
          def remoteJmx = "${JM_SCRIPTS}/${jmxName}"
          def remoteJtl = "${JM_RESULTS}/${jmxName.replace('.jmx','.jtl')}"
          def reportDir = "${JM_HTML}/${jmxName.replace('.jmx','')}"

          env.REPORT_DIR = reportDir

          // 1) copy JMX
          sh """
            sshpass -p '${JM_PASS}' scp -o StrictHostKeyChecking=no \\
              ${jmxName} \\
              ${JM_USER}@${JM_VM}:${remoteJmx}
          """

          // 2) run JMeter (clear old results & generate HTML)
          sh """
            sshpass -p '${JM_PASS}' ssh -o StrictHostKeyChecking=no ${JM_USER}@${JM_VM} '
              rm -rf ${reportDir} &&
              ${JM_BIN} -f -n \\
                -t ${remoteJmx} \\
                -l ${remoteJtl} \\
                -e -o ${reportDir}
            '
          """

          // 3) debug
          sh """
            sshpass -p '${JM_PASS}' ssh -o StrictHostKeyChecking=no ${JM_USER}@${JM_VM} '
              echo "→ JTL file:"; ls -lh ${remoteJtl} || echo "   MISSING!"
              echo "→ HTML report dir:"; ls -l ${reportDir} || echo "   MISSING!"
            '
          """
        }
      }
    }

    stage('Fetch & Publish HTML Report') {
      steps {
        sh """
          mkdir -p reports/output
          sshpass -p '${JM_PASS}' scp -o StrictHostKeyChecking=no -r \\
            ${JM_USER}@${JM_VM}:\${REPORT_DIR}/* reports/output/
        """
        publishHTML(target: [
          reportDir:   'reports/output',
          reportFiles: 'index.html',
          reportName:  'JMeter Test Report'
        ])
      }
    }
  }
}
