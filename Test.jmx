pipeline {
  agent any

  environment {
    // ────────── JMeter VM ──────────
    JM_VM        = '10.216.33.52'
    JM_USER      = 'hdfcbank'
    JM_PASS      = 'PerfTest@1'
    JM_BIN       = '/home1/jmeter/bin/jmeter.sh'
    JM_SCRIPTS   = '/home1/QK/MBR/scripts'
    JM_RESULTS   = '/home1/QK/MBR/Results'
    JM_HTML      = '/home1/QK/MBR/HTML_Reports'

    // ────────── Pod-check VM ──────────
    POD_VM       = '10.216.33.44'
    POD_USER     = 'hdfcbank'
    POD_PASS     = 'perf@123'
    POD_NS       = 'perf-mc'
    APP_LABEL    = 'user-profile-v1'   // your Deployment’s app label
  }

  stages {
    stage('Wait for Pod to be Running') {
      steps {
        script {
          // give it up to 10 minutes before failing
          timeout(time: 10, unit: 'MINUTES') {
            waitUntil {
              // exactly the same sshpass-ssh pattern as your JMeter stage
              def nonRunning = sh(
                script: """
                  sshpass -p '${POD_PASS}' ssh -o StrictHostKeyChecking=no \\
                    ${POD_USER}@${POD_VM} '
                      kubectl get pods -n ${POD_NS} -l app=${APP_LABEL} \\
                        --field-selector=status.phase!=Running --no-headers || true
                    '
                """,
                returnStdout: true
              ).trim()

              if (nonRunning) {
                echo """
Pods not yet Running:
${nonRunning}
"""
                return false   // loop again
              } else {
                echo "✅ All pods for app=${APP_LABEL} are Running"
                return true    // exit waitUntil
              }
            }
          }
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Run JMeter on Remote VM') {
      steps {
        script {
          def jmxName   = 'testplan.jmx'
          def remoteJmx = "${JM_SCRIPTS}/${jmxName}"
          def remoteJtl = "${JM_RESULTS}/${jmxName.replace('.jmx','.jtl')}"
          def reportDir = "${JM_HTML}/${jmxName.replace('.jmx','')}"
          env.REPORT_DIR = reportDir

          // 1) copy JMX
          sh """
            sshpass -p '${JM_PASS}' scp -o StrictHostKeyChecking=no \\
              ${jmxName} \\
              ${JM_USER}@${JM_VM}:${remoteJmx}
          """

          // 2) run JMeter
          sh """
            sshpass -p '${JM_PASS}' ssh -o StrictHostKeyChecking=no ${JM_USER}@${JM_VM} '
              rm -rf ${reportDir} &&
              ${JM_BIN} -f -n \\
                -t ${remoteJmx} \\
                -l ${remoteJtl} \\
                -e -o ${reportDir}
            '
          """

          // 3) debug listing
          sh """
            sshpass -p '${JM_PASS}' ssh -o StrictHostKeyChecking=no ${JM_USER}@${JM_VM} '
              echo "→ JTL file:"; ls -lh ${remoteJtl} || echo "   MISSING!"
              echo "→ HTML report dir:"; ls -l ${reportDir} || echo "   MISSING!"
            '
          """
        }
      }
    }

    stage('Fetch & Publish HTML Report') {
      steps {
        sh """
          mkdir -p reports/output
          sshpass -p '${JM_PASS}' scp -o StrictHostKeyChecking=no -r \\
            ${JM_USER}@${JM_VM}:\${REPORT_DIR}/* reports/output/
        """
        publishHTML(target: [
          reportDir:   'reports/output',
          reportFiles: 'index.html',
          reportName:  'JMeter Test Report'
        ])
      }
    }
  }
}
