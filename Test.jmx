pipeline {
    agent any

    stages {
        stage('Clone Repository') {
            steps {
                script {
                    checkout scm  // clone the current repo
                }
            }
        }

        stage('Run JMeter on Remote Machine') {
            steps {
                script {
                    // Define remote VM and credentials
                    def vm = '10.216.55.34'             // your JMeter VM IP
                    def pwd = 'hdfc@123'                // password for SSH
                    def jmxFilePath = 'testplan.jmx'    // path to JMX file in repo
                    def remoteDir = '/tmp/jmeter-run'   // temp dir on remote machine

                    // Transfer the .jmx to remote machine
                    sh """
                        sshpass -p '${pwd}' ssh -o StrictHostKeyChecking=no hdfcbank@${vm} 'mkdir -p ${remoteDir}'
                        sshpass -p '${pwd}' scp -o StrictHostKeyChecking=no ${jmxFilePath} hdfcbank@${vm}:${remoteDir}/
                    """

                    // Run JMeter remotely
                    sh """
                        sshpass -p '${pwd}' ssh -o StrictHostKeyChecking=no hdfcbank@${vm} '
                            mkdir -p ${remoteDir}/output &&
                            jmeter -n -t ${remoteDir}/testplan.jmx -l ${remoteDir}/results.jtl -e -o ${remoteDir}/output
                        '
                    """

                    // Bring the report back to Jenkins for publishing
                    sh """
                        mkdir -p reports
                        sshpass -p '${pwd}' scp -o StrictHostKeyChecking=no -r hdfcbank@${vm}:${remoteDir}/output ./reports/
                    """
                }
            }
        }

        stage('Publish Report') {
            steps {
                publishHTML(target: [
                    reportDir: 'reports/output',
                    reportFiles: 'index.html',
                    reportName: 'JMeter Test Report'
                ])
            }
        }
    }
}
