pipeline {
    agent any

    environment {
        VM_IP = '10.216.55.34'
        VM_USER = 'hdfcbank'
        VM_PASS = 'hdfc@123'
        DATE_TAG = sh(script: 'date +%F', returnStdout: true).trim()  // gets YYYY-MM-DD
    }

    stages {
        stage('Clone Repo') {
            steps {
                checkout scm
            }
        }

        stage('Upload .jmx File') {
            steps {
                script {
                    def remoteJmx = "/home1/QK/MBR/scripts/MBR_R1_Perf1_Sanity_Usecase_Flows_30-Nov-2023/MBR_PT_U1_100U_270Ct.jmx"
                    sh """
                        sshpass -p '${VM_PASS}' scp -o StrictHostKeyChecking=no testplan.jmx ${VM_USER}@${VM_IP}:${remoteJmx}
                    """
                }
            }
        }

        stage('Run JMeter') {
            steps {
                script {
                    def reportDir = "/home1/QK/MBR/HTMLReports/MBR_Report_${env.DATE_TAG}"
                    def resultFile = "/home1/QK/MBR/Results/MBR_Result_${env.DATE_TAG}.jtl"
                    def remoteJmx = "/home1/QK/MBR/scripts/MBR_R1_Perf1_Sanity_Usecase_Flows_30-Nov-2023/MBR_PT_U1_100U_270Ct.jmx"

                    sh """
                        sshpass -p '${VM_PASS}' ssh -o StrictHostKeyChecking=no ${VM_USER}@${VM_IP} '
                            mkdir -p ${reportDir} &&
                            /home1/apache-jmeter-5.4.2_bkKP/bin/jmeter.sh -n \
                            -t ${remoteJmx} \
                            -l ${resultFile} \
                            -e -o ${reportDir}
                        '
                    """
                }
            }
        }

        stage('Copy Report Back') {
            steps {
                sh """
                    mkdir -p reports
                    sshpass -p '${VM_PASS}' scp -o StrictHostKeyChecking=no -r \
                    ${VM_USER}@${VM_IP}:/home1/QK/MBR/HTMLReports/MBR_Report_${DATE_TAG} ./reports/
                """
            }
        }

        stage('Publish Report') {
            steps {
                publishHTML(target: [
                    reportDir: "reports/MBR_Report_${env.DATE_TAG}",
                    reportFiles: 'index.html',
                    reportName: "MBR Report (${env.DATE_TAG})"
                ])
            }
        }
    }
}
