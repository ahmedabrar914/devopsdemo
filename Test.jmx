pipeline {
  agent any

  environment {
    VM             = ''                          // your JMeter VM IP
    USER           = ''                              // SSH user on that VM
    PASS           = '1'                            // SSH password
    JMETER_BIN     = '/home1/jmeter/bin/jmeter.sh'           // full path to jmeter.sh on VM
    REMOTE_SCRIPT  = '/home1/QK/MBR/scripts'                 // where your .jmx files live
    REMOTE_RESULTS = '/home1/QK/MBR/Results'                 // where JMeter should write the .jtl
    REMOTE_HTML    = '/home1/QK/MBR/HTML_Reports'            // base folder for HTML reports
  }

  stages {
    stage('Checkout') {
      steps {
        // brings testplan.jmx (and anything else) into workspace
        checkout scm
      }
    }

    stage('Run JMeter on Remote VM') {
      steps {
        script {
          // name of your JMX in the repo:
          def jmxName    = 'testplan.jmx'

          // compute the remote paths
          def remoteJmx  = "${env.REMOTE_SCRIPT}/${jmxName}"
          def remoteJtl  = "${env.REMOTE_RESULTS}/${jmxName.replace('.jmx','.jtl')}"
          def reportDir  = "${env.REMOTE_HTML}/${jmxName.replace('.jmx','')}"
          // we’ll need this for the fetch stage:
          env.REPORT_DIR = reportDir

          // 1) copy up the JMX (overwrites if it exists)
          sh """
            sshpass -p '${env.PASS}' scp -o StrictHostKeyChecking=no \
              ${jmxName} \
              ${env.USER}@${env.VM}:${remoteJmx}
          """

          // 2) run JMeter (clean old report first, then execute)
          sh """
            sshpass -p '${env.PASS}' ssh -o StrictHostKeyChecking=no ${env.USER}@${env.VM} '
              rm -rf ${reportDir} &&
              ${env.JMETER_BIN} -n \\
                -t ${remoteJmx} \\
                -l ${remoteJtl} \\
                -e -o ${reportDir}
            '
          """

          // 3) debug: list what actually got created
          sh """
            sshpass -p '${env.PASS}' ssh -o StrictHostKeyChecking=no ${env.USER}@${env.VM} '
              echo "→ JTL file:"; ls -lh ${remoteJtl} || echo "   MISSING!"
              echo "→ HTML report dir:"; ls -l ${reportDir} || echo "   MISSING!"
            '
          """
        }
      }
    }

    stage('Fetch & Publish HTML Report') {
      steps {
        // bring back the entire folder
        sh """
          mkdir -p reports/output
          sshpass -p '${env.PASS}' scp -o StrictHostKeyChecking=no -r \\
            ${env.USER}@${env.VM}:\${REPORT_DIR}/* reports/output/
        """

        // publish index.html
        publishHTML(target: [
          reportDir:   'reports/output',
          reportFiles: 'index.html',
          reportName:  'JMeter Test Report'
        ])
      }
    }
  }
}
