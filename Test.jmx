pipeline {
    agent any

    stages {
        stage('Clone Repo') {
            steps {
                checkout scm
            }
        }

        stage('Upload .jmx File to Remote JMeter Path') {
            steps {
                script {
                    def vm = '10.216.55.34'
                    def pwd = 'hdfc@123'
                    def remoteJmxPath = '/home1/QK/MBR/scripts/MBR_R1_Perf1_Sanity_Usecase_Flows_30-Nov-2023/MBR_PT_U1_100U_270Ct.jmx'

                    sh """
                        sshpass -p '${pwd}' scp -o StrictHostKeyChecking=no testplan.jmx hdfcbank@${vm}:${remoteJmxPath}
                    """
                }
            }
        }

        stage('Run JMeter Test on Remote VM') {
            steps {
                script {
                    def vm = '10.216.55.34'
                    def pwd = 'hdfc@123'
                    def jtlPath = '/home1/QK/MBR/Results/R28_100U_270Ct.jtl'
                    def htmlReportPath = '/home1/QK/MBR/HTMLReports/27Oct_MBR.html'

                    sh """
                        sshpass -p '${pwd}' ssh -o StrictHostKeyChecking=no hdfcbank@${vm} '
                            /home1/apache-jmeter-5.4.2_bkKP/bin/jmeter.sh -n \
                            -t ${remoteJmxPath} \
                            -l ${jtlPath} \
                            -e -o ${htmlReportPath}
                        '
                    """
                }
            }
        }

        stage('Copy HTML Report to Jenkins') {
            steps {
                sh """
                    mkdir -p reports
                    sshpass -p 'hdfc@123' scp -o StrictHostKeyChecking=no -r \
                    hdfcbank@10.216.55.34:/home1/QK/MBR/HTMLReports/27Oct_MBR.html ./reports/
                """
            }
        }

        stage('Publish Report') {
            steps {
                publishHTML(target: [
                    reportDir: 'reports',
                    reportFiles: '27Oct_MBR.html',
                    reportName: 'MBR JMeter Report'
                ])
            }
        }
    }
}
