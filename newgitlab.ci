spec:
  inputs:
    target_env:
      options: ['dev', 'nonprod', 'prod']
      default: 'dev'
      description: 'Select target environment'

    primary_region:
      options: ['us-west-2', 'us-east-1']
      default: 'us-west-2'
      description: 'Select primary region'

    run_mode:
      options: ['validate_only', 'execute']
      default: 'validate_only'
      description: 'Select execution mode'

    dr_action:
      options: ['', 'failover', 'failback']
      default: ''
      description: 'Select DR operation'

---

workflow:
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_PIPELINE_SOURCE == "web"'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - when: never

default:
  retry:
    max: 2
    when:
      - script_failure
      - runner_system_failure
      - unknown_failure
      - scheduler_failure

stages:
  - test
  - secret-detection
  - validate
  - terraform-format-check
  - terraform-scan
  - plan
  - apply
  - failover
  - failback
  - notify

variables:
  SECRET_DETECTION_ENABLED: "true"
  STAGE_ROLE_ARN: "arn:aws:iam::792014834907:role/gitlab-vaas-iac-role"
  PROD_ROLE_ARN: "arn:aws:iam::100828516796:role/gitlab-vaas-iac-role"
  TF_IN_AUTOMATION: "true"
  TF_INPUT: "false"
  PIP_CACHE_DIR: "$CI_PROJECT_DIR/.cache/pip"

include:
  - template: Security/Secret-Detection.gitlab-ci.yml

secret_detection:
  stage: secret-detection
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "web"'
      when: never

# -------------------------------------------------------
# Change anchors
# -------------------------------------------------------
.root_changes: &root_changes
  changes:
    - "*.tf"
    - "*.tf.json"
    - ".gitlab-ci.yml"
    - modules/**/*
    - shared/**/*

.dev_usw2_changes: &dev_usw2_changes
  changes:
    - environments/dev/primary/us-west-2/**/*

.dev_use1_changes: &dev_use1_changes
  changes:
    - environments/dev/dr/us-east-1/**/*

.nonprod_usw2_changes: &nonprod_usw2_changes
  changes:
    - environments/nonprod/us-west-2/**/*

.nonprod_use1_changes: &nonprod_use1_changes
  changes:
    - environments/nonprod/us-east-1/**/*

# -------------------------------------------------------
# OIDC -> Assume Role
# -------------------------------------------------------
.assume_aws_role: &assume_aws_role
  - |
    set -euo pipefail

    if [ -z "${AWS_ROLE_ARN:-}" ]; then
      echo "ERROR: AWS_ROLE_ARN is not set for this job"
      exit 1
    fi

    if [ -z "${GITLAB_OIDC_TOKEN:-}" ]; then
      echo "ERROR: GITLAB_OIDC_TOKEN is not available"
      exit 1
    fi

    echo "Assuming role: ${AWS_ROLE_ARN}"
    aws_sts_output=$(aws sts assume-role-with-web-identity \
      --role-arn "${AWS_ROLE_ARN}" \
      --role-session-name "GitLabRunner-${CI_PROJECT_ID}-${CI_PIPELINE_ID}-${CI_JOB_ID}" \
      --web-identity-token "${GITLAB_OIDC_TOKEN}" \
      --duration-seconds 3600 \
      --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
      --output text)

    export AWS_ACCESS_KEY_ID="$(echo "${aws_sts_output}" | awk '{print $1}')"
    export AWS_SECRET_ACCESS_KEY="$(echo "${aws_sts_output}" | awk '{print $2}')"
    export AWS_SESSION_TOKEN="$(echo "${aws_sts_output}" | awk '{print $3}')"

    echo "Caller identity:"
    aws sts get-caller-identity

# -------------------------------------------------------
# Common terraform base
# -------------------------------------------------------
.terraform_base:
  image: hashicorp/terraform:1.12.2
  variables:
    KUBERNETES_POD_LABELS_INTERNET_ALLOW: "internet=allow"
  id_tokens:
    GITLAB_OIDC_TOKEN:
      aud: https://gitlab.corp.zscaler.com
  cache:
    key: "${CI_JOB_NAME}"
    paths:
      - .cache/pip
  before_script:
    - apk update
    - apk add --no-cache bash python3 py3-pip jq
    - pip3 install --no-cache-dir awscli
    - aws --version
    - terraform version
    - *assume_aws_role

# -------------------------------------------------------
# Validation jobs
# -------------------------------------------------------
check-rebased:
  stage: validate
  image: alpine/git:latest
  script:
    - |
      set -e

      if [ "$CI_COMMIT_BRANCH" = "$CI_DEFAULT_BRANCH" ]; then
        echo "On default branch, continuing pipeline"
        exit 0
      fi

      git fetch origin "$CI_DEFAULT_BRANCH"

      MERGE_BASE=$(git merge-base HEAD "origin/$CI_DEFAULT_BRANCH")
      MAIN_HEAD=$(git rev-parse "origin/$CI_DEFAULT_BRANCH")

      if [ "$MERGE_BASE" != "$MAIN_HEAD" ]; then
        echo "ERROR: Branch $CI_COMMIT_BRANCH is not rebased on $CI_DEFAULT_BRANCH"
        echo "Please rebase your branch before pushing"
        exit 1
      else
        echo "Branch is properly rebased on $CI_DEFAULT_BRANCH"
      fi
  allow_failure: true
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "web"'
      when: never

terraform-format-check:
  stage: terraform-format-check
  image: hashicorp/terraform:1.12.2
  script:
    - |
      set -e
      echo "Checking Terraform formatting..."
      terraform fmt -check -recursive
  allow_failure: false
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "web"'
      when: never

terraform-scan:
  image: golang:latest
  stage: terraform-scan
  variables:
    KUBERNETES_POD_LABELS_INTERNET_ALLOW: "internet=allow"
  before_script:
    - go install github.com/aquasecurity/tfsec/cmd/tfsec@latest
  script:
    - tfsec .
  needs:
    - check-rebased
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "web"'
      when: never

# -------------------------------------------------------
# Terraform plan/apply templates
# -------------------------------------------------------
.terraform_plan_template:
  extends: .terraform_base
  stage: plan
  needs:
    - terraform-scan
  script:
    - |
      set -euo pipefail

      echo "CI_JOB_NAME=${CI_JOB_NAME}"
      echo "ENV_DIR=${ENV_DIR}"
      echo "TFVARS_FILE=${TFVARS_FILE}"
      echo "AWS_ROLE_ARN=${AWS_ROLE_ARN}"

      test -f "${ENV_DIR}/backend.tf"
      test -f "${TFVARS_FILE}"

      cp "${ENV_DIR}/backend.tf" ./backend.tf

      echo "Running terraform init..."
      terraform init

      echo "Running terraform validate..."
      terraform validate

      echo "Running terraform plan..."
      terraform plan -out="tfplan-${CI_JOB_NAME}.tfplan" -var-file="${TFVARS_FILE}"

      echo "Generated plan artifact:"
      ls -l "tfplan-${CI_JOB_NAME}.tfplan"
  artifacts:
    when: always
    paths:
      - "tfplan-${CI_JOB_NAME}.tfplan"
      - "status_${CI_JOB_NAME}.txt"
    expire_in: 1 day
  after_script:
    - echo "$CI_JOB_STATUS" > "status_${CI_JOB_NAME}.txt"

.terraform_apply_template:
  extends: .terraform_base
  stage: apply
  script:
    - |
      set -euo pipefail

      echo "CI_JOB_NAME=${CI_JOB_NAME}"
      echo "ENV_DIR=${ENV_DIR}"
      echo "TFVARS_FILE=${TFVARS_FILE}"
      echo "AWS_ROLE_ARN=${AWS_ROLE_ARN}"

      test -f "${ENV_DIR}/backend.tf"
      test -f "${TFVARS_FILE}"

      cp "${ENV_DIR}/backend.tf" ./backend.tf

      echo "Running terraform init..."
      terraform init

      echo "Running terraform apply..."
      terraform apply -auto-approve -var-file="${TFVARS_FILE}"
  artifacts:
    when: always
    paths:
      - "status_${CI_JOB_NAME}.txt"
    expire_in: 1 day
  after_script:
    - echo "$CI_JOB_STATUS" > "status_${CI_JOB_NAME}.txt"

# -------------------------------------------------------
# DEV plan jobs
# -------------------------------------------------------
dev_plan_usw2:
  extends: .terraform_plan_template
  variables:
    AWS_ROLE_ARN: "$STAGE_ROLE_ARN"
    ENV_DIR: "environments/dev/primary/us-west-2"
    TFVARS_FILE: "environments/dev/primary/us-west-2/parameters.primary.tfvars"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      <<: *dev_usw2_changes
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      <<: *dev_usw2_changes
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      <<: *root_changes
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      <<: *root_changes
    - when: never

dev_plan_use1:
  extends: .terraform_plan_template
  variables:
    AWS_ROLE_ARN: "$STAGE_ROLE_ARN"
    ENV_DIR: "environments/dev/dr/us-east-1"
    TFVARS_FILE: "environments/dev/dr/us-east-1/parameters.dr.tfvars"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      <<: *dev_use1_changes
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      <<: *dev_use1_changes
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      <<: *root_changes
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      <<: *root_changes
    - when: never

# -------------------------------------------------------
# NONPROD plan jobs
# -------------------------------------------------------
nonprod_plan_usw2:
  extends: .terraform_plan_template
  variables:
    AWS_ROLE_ARN: "$PROD_ROLE_ARN"
    ENV_DIR: "environments/nonprod/us-west-2"
    TFVARS_FILE: "environments/nonprod/us-west-2/parameters.usw2-nonprod.tfvars"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      <<: *nonprod_usw2_changes
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      <<: *nonprod_usw2_changes
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      <<: *root_changes
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      <<: *root_changes
    - when: never

nonprod_plan_use1:
  extends: .terraform_plan_template
  variables:
    AWS_ROLE_ARN: "$PROD_ROLE_ARN"
    ENV_DIR: "environments/nonprod/us-east-1"
    TFVARS_FILE: "environments/nonprod/us-east-1/parameters.dr.tfvars"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      <<: *nonprod_use1_changes
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      <<: *nonprod_use1_changes
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      <<: *root_changes
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      <<: *root_changes
    - when: never

# -------------------------------------------------------
# DEV apply jobs
# Manual by default
# -------------------------------------------------------
dev_apply_usw2:
  extends: .terraform_apply_template
  variables:
    AWS_ROLE_ARN: "$STAGE_ROLE_ARN"
    ENV_DIR: "environments/dev/primary/us-west-2"
    TFVARS_FILE: "environments/dev/primary/us-west-2/parameters.primary.tfvars"
  needs:
    - job: dev_plan_usw2
      artifacts: true
  dependencies:
    - dev_plan_usw2
  rules:
    - if: '$CI_PIPELINE_SOURCE == "web" && $[[ inputs.run_mode ]] == "execute"'
      when: manual
    - when: never

dev_apply_use1:
  extends: .terraform_apply_template
  variables:
    AWS_ROLE_ARN: "$STAGE_ROLE_ARN"
    ENV_DIR: "environments/dev/dr/us-east-1"
    TFVARS_FILE: "environments/dev/dr/us-east-1/parameters.dr.tfvars"
  needs:
    - job: dev_plan_use1
      artifacts: true
  dependencies:
    - dev_plan_use1
  rules:
    - if: '$CI_PIPELINE_SOURCE == "web" && $[[ inputs.run_mode ]] == "execute"'
      when: manual
    - when: never

# -------------------------------------------------------
# NONPROD apply jobs
# Manual by default
# -------------------------------------------------------
nonprod_apply_usw2:
  extends: .terraform_apply_template
  variables:
    AWS_ROLE_ARN: "$PROD_ROLE_ARN"
    ENV_DIR: "environments/nonprod/us-west-2"
    TFVARS_FILE: "environments/nonprod/us-west-2/parameters.usw2-nonprod.tfvars"
  needs:
    - job: nonprod_plan_usw2
      artifacts: true
  dependencies:
    - nonprod_plan_usw2
  rules:
    - if: '$CI_PIPELINE_SOURCE == "web" && $[[ inputs.run_mode ]] == "execute"'
      when: manual
    - when: never

nonprod_apply_use1:
  extends: .terraform_apply_template
  variables:
    AWS_ROLE_ARN: "$PROD_ROLE_ARN"
    ENV_DIR: "environments/nonprod/us-east-1"
    TFVARS_FILE: "environments/nonprod/us-east-1/parameters.dr.tfvars"
  needs:
    - job: nonprod_plan_use1
      artifacts: true
  dependencies:
    - nonprod_plan_use1
  rules:
    - if: '$CI_PIPELINE_SOURCE == "web" && $[[ inputs.run_mode ]] == "execute"'
      when: manual
    - when: never