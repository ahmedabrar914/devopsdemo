# -------------------------------------------------------
# Optional apply jobs
# Keep manual
# -------------------------------------------------------
dev_apply_usw2:
  image: hashicorp/terraform:1.12.2
  stage: apply
  variables:
    KUBERNETES_POD_LABELS_INTERNET_ALLOW: "internet=allow"
  id_tokens:
    GITLAB_OIDC_TOKEN:
      aud: https://gitlab.corp.zscaler.com
  before_script:
    - apk update
    - apk add --no-cache aws-cli bash
    - *assume_aws_stage_role
  script:
    - cp ./environments/dev/primary/us-west-2/backend.tf ./backend.tf
    - terraform init
    - terraform apply -auto-approve -var-file="./environments/dev/primary/us-west-2/parameters.primary.tfvars"
  needs:
    - job: dev_plan_usw2
      artifacts: true
  rules:
    - if: '$CI_PIPELINE_SOURCE == "web" && $[[ inputs.run_mode ]] == "execute"'
      when: manual
    - when: never
  artifacts:
    paths:
      - status_dev_apply_usw2.txt
  after_script:
    - echo "$CI_JOB_STATUS" > status_dev_apply_usw2.txt

dev_apply_use1:
  image: hashicorp/terraform:1.12.2
  stage: apply
