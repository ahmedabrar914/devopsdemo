spec:
  inputs:
    target_env:
      options: ['dev', 'nonprod', 'prod']
      default: 'dev'
      description: 'Select target environment'

    primary_region:
      options: ['us-west-2', 'us-east-1']
      default: 'us-west-2'
      description: 'Select primary region'

    run_mode:
      options: ['validate_only', 'execute']
      default: 'validate_only'
      description: 'Select execution mode'

    dr_action:
      options: ['', 'failover', 'failback']
      default: ''
      description: 'Select DR operation'

---

workflow:
  rules:
    - if: '$CI_PIPELINE_SOURCE == "web"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - when: never

default:
  retry:
    max: 2
    when:
      - script_failure
      - runner_system_failure
      - unknown_failure
      - scheduler_failure

stages:
  - test
  - secret-detection
  - validate
  - terraform-format-check
  - terraform-scan
  - plan
  - apply
  - failover
  - failback
  - notify

variables:
  SECRET_DETECTION_ENABLED: 'true'
  STAGE_ROLE_ARN: arn:aws:iam::792014834907:role/gitlab-vaas-iac-role
  PROD_ROLE_ARN: arn:aws:iam::100828516796:role/gitlab-vaas-iac-role

secret_detection:
  stage: secret-detection
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "web"'
      when: never

include:
  - template: Security/Secret-Detection.gitlab-ci.yml

# -------------------------------------------------------
# Root terraform changes
# If these files change, all plan jobs should run
# -------------------------------------------------------
.root_tf_changes: &root_tf_changes
  changes:
    - "*.tf"
    - "*.tf.json"
    - modules/**/*
    - shared/**/*

# -------------------------------------------------------
# Assume role blocks
# -------------------------------------------------------
.assume_aws_stage_role: &assume_aws_stage_role
  - |
    aws_sts_output=$(aws sts assume-role-with-web-identity \
      --role-arn ${STAGE_ROLE_ARN} \
      --role-session-name "GitLabRunner-${CI_PROJECT_ID}-${CI_PIPELINE_ID}" \
      --web-identity-token ${GITLAB_OIDC_TOKEN} \
      --duration-seconds 3600 \
      --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
      --output text)
    export $(printf "AWS_ACCESS_KEY_ID=%s AWS_SECRET_ACCESS_KEY=%s AWS_SESSION_TOKEN=%s" $aws_sts_output)
    echo "Assumed AWS role ${STAGE_ROLE_ARN}"
    aws sts get-caller-identity

.assume_aws_prod_role: &assume_aws_prod_role
  - |
    aws_sts_output=$(aws sts assume-role-with-web-identity \
      --role-arn ${PROD_ROLE_ARN} \
      --role-session-name "GitLabRunner-${CI_PROJECT_ID}-${CI_PIPELINE_ID}" \
      --web-identity-token ${GITLAB_OIDC_TOKEN} \
      --duration-seconds 3600 \
      --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
      --output text)
    export $(printf "AWS_ACCESS_KEY_ID=%s AWS_SECRET_ACCESS_KEY=%s AWS_SESSION_TOKEN=%s" $aws_sts_output)
    echo "Assumed AWS role ${PROD_ROLE_ARN}"
    aws sts get-caller-identity

# -------------------------------------------------------
# Validate if branch is rebased
# -------------------------------------------------------
check-rebased:
  stage: validate
  image: alpine/git:latest
  script:
    - |
      if [ "$CI_COMMIT_BRANCH" = "main" ]; then
        echo "On main branch, continuing pipeline"
        exit 0
      fi

      git fetch origin main

      MERGE_BASE=$(git merge-base HEAD origin/main)
      MAIN_HEAD=$(git rev-parse origin/main)

      if [ "$MERGE_BASE" != "$MAIN_HEAD" ]; then
        echo "ERROR: Branch $CI_COMMIT_BRANCH is not rebased on main!"
        echo "Please rebase your branch before pushing."
        exit 1
      else
        echo "Branch is properly rebased on main, continuing pipeline"
      fi
  allow_failure: true
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "web"'
      when: never

terraform-format-check:
  stage: terraform-format-check
  image: hashicorp/terraform:1.12.2
  script:
    - echo "Checking Terraform formatting..."
    - if ! terraform fmt -check; then
        echo "The following files failed formatting:";
        terraform fmt -check;
        exit 1;
      fi
  allow_failure: false
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "web"'
      when: never

terraform-scan:
  image: golang:latest
  stage: terraform-scan
  variables:
    KUBERNETES_POD_LABELS_INTERNET_ALLOW: "internet=allow"
  before_script:
    - go install github.com/aquasecurity/tfsec/cmd/tfsec@latest
  script:
    - tfsec .
  needs:
    - check-rebased
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "web"'
      when: never

# -------------------------------------------------------
# DEV plan jobs
# -------------------------------------------------------
dev_plan_usw2:
  image: hashicorp/terraform:1.12.2
  stage: plan
  variables:
    KUBERNETES_POD_LABELS_INTERNET_ALLOW: "internet=allow"
  id_tokens:
    GITLAB_OIDC_TOKEN:
      aud: https://gitlab.corp.zscaler.com
  before_script:
    - apk update
    - apk add --no-cache aws-cli bash
    - *assume_aws_stage_role
  script:
    - test -f "./environments/dev/primary/us-west-2/backend.tf"
    - test -f "./environments/dev/primary/us-west-2/parameters.primary.tfvars"
    - cp ./environments/dev/primary/us-west-2/backend.tf ./backend.tf
    - terraform init
    - terraform validate
    - echo "Planning DEV us-west-2"
    - terraform plan -out=tfplan-dev_plan_usw2.tfplan -var-file="./environments/dev/primary/us-west-2/parameters.primary.tfvars"
  needs:
    - terraform-scan
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes:
        - environments/dev/primary/us-west-2/**/*
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      changes:
        - environments/dev/primary/us-west-2/**/*
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      <<: *root_tf_changes
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      <<: *root_tf_changes
    - when: never
  artifacts:
    when: always
    paths:
      - tfplan-dev_plan_usw2.tfplan
      - status_dev_plan_usw2.txt
    expire_in: 1 day
  after_script:
    - echo "$CI_JOB_STATUS" > status_dev_plan_usw2.txt

dev_plan_use1:
  image: hashicorp/terraform:1.12.2
  stage: plan
  variables:
    KUBERNETES_POD_LABELS_INTERNET_ALLOW: "internet=allow"
  id_tokens:
    GITLAB_OIDC_TOKEN:
      aud: https://gitlab.corp.zscaler.com
  before_script:
    - apk update
    - apk add --no-cache aws-cli bash
    - *assume_aws_stage_role
  script:
    - test -f "./environments/dev/dr/us-east-1/backend.tf"
    - test -f "./environments/dev/dr/us-east-1/parameters.dr.tfvars"
    - cp ./environments/dev/dr/us-east-1/backend.tf ./backend.tf
    - terraform init
    - terraform validate
    - echo "Planning DEV us-east-1"
    - terraform plan -out=tfplan-dev_plan_use1.tfplan -var-file="./environments/dev/dr/us-east-1/parameters.dr.tfvars"
  needs:
    - terraform-scan
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes:
        - environments/dev/dr/us-east-1/**/*
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      changes:
        - environments/dev/dr/us-east-1/**/*
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      <<: *root_tf_changes
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      <<: *root_tf_changes
    - when: never
  artifacts:
    when: always
    paths:
      - tfplan-dev_plan_use1.tfplan
      - status_dev_plan_use1.txt
    expire_in: 1 day
  after_script:
    - echo "$CI_JOB_STATUS" > status_dev_plan_use1.txt

